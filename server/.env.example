# Copy to the project root as .env.hairline; never commit the filled file.
# Default: DeepSeek. Other OpenAI-compatible providers can use their own URL/model.
HAIRLINE_MODEL_BASE_URL=https://api.deepseek.com
HAIRLINE_MODEL_API_KEY=
HAIRLINE_MODEL=deepseek-flash
# A separate private token for this generation service (not the model API key).
HAIRLINE_ACCESS_TOKEN=
HAIRLINE_HOST=127.0.0.1
HAIRLINE_PORT=4341
# Explicit comma-separated browser origins for cross-origin deployment.
HAIRLINE_ALLOWED_ORIGINS=
HAIRLINE_DATA_DIR=work/hairline-data
HAIRLINE_JSON_MODE=true
