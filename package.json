{
  "name": "milkstone",
  "version": "1.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "hairline:serve": "node --env-file-if-exists=.env.hairline server/hairline-server.mjs",
    "skill:pack": "node scripts/package-skill.mjs",
    "predev": "pnpm skill:pack",
    "prebuild": "pnpm skill:pack",
    "test": "node --test tests/*.test.mjs",
    "cli": "node bin/milk-white-web-design.mjs",
    "prepack": "node scripts/validate-skill.mjs",
    "licenses:sync": "node scripts/sync-third-party-notices.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/vue": "1.54.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-table": "9.2.8",
    "@types/node": "24.10.0",
    "@unovis/ts": "1.7.1",
    "@unovis/vue": "1.7.1",
    "@vee-validate/zod": "4.15.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue-flow/core": "1.48.2",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.0.0",
    "embla-carousel-fade": "8.6.0",
    "embla-carousel-vue": "8.6.0",
    "gsap": "3.15.0",
    "lucide-vue-next": "1.0.0",
    "pinia": "3.0.4",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vee-validate": "4.15.1",
    "vite": "8.3.0",
    "vue": "3.5.43",
    "vue-input-otp": "0.4.0",
    "vue-router": "4.5.1",
    "vue-sonner": "2.0.9",
    "vue-tsc": "3.1.4",
    "zod": "3.25.76"
  },
  "description": "A tactile Vue design system combining editable UI components, visual workbenches, frontend architecture, and a portable Agent Skill.",
  "bin": {
    "milk-white-web-design": "bin/milk-white-web-design.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "plugin.json",
    "docs/agent-installation.md",
    "LICENSE-NOTICE.md",
    "README.md",
    "LICENSE",
    "public/third-party-notices.md",
    "public/licenses/"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "author": "TheCrookedMan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheCrookedMan/milkstone.git"
  },
  "homepage": "https://thecrookedman.github.io/milkstone/",
  "bugs": {
    "url": "https://github.com/TheCrookedMan/milkstone/issues"
  },
  "keywords": [
    "vue",
    "shadcn-vue",
    "design-system",
    "ui-components",
    "neumorphism",
    "agent-skill",
    "workflow-editor",
    "data-visualization"
  ]
}
